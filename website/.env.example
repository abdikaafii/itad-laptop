# Copy this file to .env and fill it in. NEVER commit the real .env file.

# development | production
APP_ENV=production

# REQUIRED in production, at least 32 characters. Signs login cookies and certificate seals.
# Make one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# If you change it later, existing certificates will no longer verify. Back it up safely.
ITAD_SECRET_KEY=

# The address people use to reach the site (used in email links and QR codes).
ITAD_PUBLIC_URL=https://itad.example.com

# Where the database and uploaded logos live. Keep these on a disk that is backed up.
ITAD_DATABASE=/data/itad.sqlite3
ITAD_UPLOAD_DIR=/data/uploads

# Email. Leave SMTP_HOST empty and mails are only saved in the database (no one receives them).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Cookies are marked Secure automatically in production. Needs HTTPS in front of the app.
# Set to 1 only when Caddy/nginx (that you run) is in front of the app, so visitor IPs are read correctly.
ITAD_TRUST_PROXY=0
# ITAD_SECURE_COOKIES=1

# Development only. Shows saved emails at /dev/outbox. Never turn on for a real server.
# ITAD_DEV_OUTBOX=1

# Optional tuning
# ITAD_MAX_UPLOAD_BYTES=5242880
# ITAD_LOGIN_MAX_FAILS=5
# ITAD_LOGIN_LOCK_MINUTES=15
