# Copy to .env and change every value marked CHANGE. Never commit .env.
ITAD_ENV=production
ITAD_SECRET_KEY=CHANGE-to-a-long-random-string
ITAD_DATABASE_URL=postgresql://itad:CHANGE@db:5432/itad
POSTGRES_PASSWORD=CHANGE
ITAD_DATA_DIR=/data
ITAD_PUBLIC_URL=https://itad.example.com
# First super administrator (created on start if none exists). Use a strong password, then change it in the app.
ITAD_BOOTSTRAP_ADMIN_EMAIL=you@example.com
ITAD_BOOTSTRAP_ADMIN_PASSWORD=CHANGE-strong-password
# SMTP for verification / reset e-mails (leave empty to log e-mails to the server console)
ITAD_SMTP_HOST=
ITAD_SMTP_PORT=587
ITAD_SMTP_USER=
ITAD_SMTP_PASSWORD=
ITAD_SMTP_FROM=no-reply@example.com
# Development only: demo data and demo logins. Keep 0 in production.
ITAD_SEED_DEMO=0
